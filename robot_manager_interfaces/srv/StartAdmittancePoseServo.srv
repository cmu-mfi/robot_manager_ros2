geometry_msgs/Wrench target_wrench   # Target Wrench: Forces [Fx, Fy, Fz] in Newtons and Torques [Tx, Ty, Tz] in Nm
bool[6] selection_vector             # Axis Selection Vector [Fx, Fy, Fz, Tx, Ty, Tz] (true, false)
float64[6] mass                      # Mass / Inertia: Linear mass (kg) and Rotational inertia (kg*m^2)
float64[6] damping                   # Damping: Linear damping (N*s/m) and Rotational damping (N*m*s/rad)
float64[6] stiffness                 # Stiffness: Linear stiffness (N/m) and Rotational stiffness (N*m/rad)
float64[6] max_velocity              # Max linear velocity (m/s) & angular velocity (rad/s)
---
bool success                         # True if admittance controller successfully initialized
string message                       # Error details or operational summary
